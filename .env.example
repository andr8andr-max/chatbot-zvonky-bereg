# ============================================================================
#  НАСТРОЙКИ ЧАТ-БОТА «ЗВОНЫЙ БЕРЕГ»  ·  Ирина
#  ВСЕ СЕКРЕТЫ ВПИСЫВАЮТСЯ ТОЛЬКО СЮДА. Этот файл нельзя коммитить в git.
#
#  Как сделать:  скопируйте .env.example в .env   (или .env.local для локальных тестов)
#  Права:        chmod 600 .env   (Linux/macOS)
# ============================================================================


# ---------------------------------------------------------------------------
# 1. ВКОНТАКТЕ
# ---------------------------------------------------------------------------

# ID сообщества. Только число, без минуса и без https://vk.com/.
# Где взять: открыть сообщество → «Управление» → «Настройки» → вкладка «Работа с API».
# Либо адресная строка вида vk.com/club123456789012 → ID = 123456789012
VK_GROUP_ID=241767034

# ТОКЕН СООБЩЕСТВА. Это главный секрет бота.
# Где взять:vk.com → ваше сообщество → Управление → Дополнительно → Работа с API →
#            «Ключи доступа» → создать ключ, ВКЛЮЧИТЬ доступ к «Сообщениям».
#            Готовый токен начинается с vk1.a. или содержит длинную строку.
# ВАЖНО: это community token, а НЕ пользовательский токен. Пользовательский
#         использовать нельзя — это нарушение правил VK и риск бана.
VK_GROUP_TOKEN=

# true, если токен принадлежит сообществу (обычный случай). false не трогайте.
VK_TOKEN_IS_GROUP=true

# ID организаторов, которым разрешены служебные команды (!статус).
# Только эти люди смогут одобрять и отклонять заявки. Узнать свой ID:
# https://vk.com/id0 → профиль → «Свойства» поля «id».
# Несколько ID — через запятую, без пробелов.
VK_ADMIN_USER_IDS=

# ID бесед, куда бот шлёт уведомления о новых заявках и вопросах.
# Это НЕ id сообщества. Для беседы: откройте беседу → меню (⋮) → «Информация» →
# «Идентификатор беседы» (начинается с 2000… или 1…).
# Сюда же бот пишет участникам смену статуса, если они ещё не в личке.
#
# Беседа — основной канал уведомлений. Если уведомление дошло хотя бы в одну из
# бесед, в лички из VK_ADMIN_USER_IDS оно НЕ отправляется, чтобы организаторы не
# читали одно и то же трижды. В лички уходим только когда беседа недоступна
# сообществу (ошибка 917) или беседы не заданы вовсе.
# Исключение — экстренные оповещения (ЧП): они всегда идут и туда, и туда.
VK_ADMIN_PEER_IDS=2000000001,2000000003

# Версия API VK и таймаут Long Poll (секунд; максимум 90, рекомендуется 25).
VK_API_VERSION=5.199
VK_LP_WAIT=25

# Тестовый прогон. 1 — бот не отправляет уведомления организаторам в чат и лички
# (в лог и аудит пишется, что отправка была), отвечает пользователю как обычно.
# Нужно, чтобы при проверке сценария в боевом сообществе никто не получил
# «ЭКСТРЕННАЯ СИТУАЦИЯ» на самом деле.
DRY_RUN=0


# ---------------------------------------------------------------------------
# 2. ПРОXY API  (модель ling-3.0-flash)
# ---------------------------------------------------------------------------

# Базовый адрес ProxyAPI. Менять только если вы используете другой шлюз.
# Обязательно https:// — по http ключ передавать нельзя, бот это не запустит.
LLM_BASE_URL=https://api.proxyapi.ru/v1

# КЛЮЧ PROXY API. Второй главный секрет.
# Где взять: proxyapi.ru → личный кабинет → раздел «Ключи API» → «Создать ключ» →
#            дайте имя (например «zv-bereg-bot») и СОХРАНИТЕ ключ — он показан один раз.
# Ключ начинается с «sk-».
LLM_API_KEY=

# Идентификатор модели. Формат: вендор/название через слэш.
# Точное имя проверьте: curl https://api.proxyapi.ru/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# и найдите в ответе «ling».
LLM_MODEL=inclusionai/ling-3.0-flash

# Параметры генерации. 0.6 — рекомендованная температура для ling-3.0-flash.
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=30
LLM_RETRIES=2

# false — бот работает без модели (все сценарии и FAQ уйдут на шаблоны).
# Полезно, чтобы проверить анкету, не тратя токены.
LLM_ENABLED=true


# ---------------------------------------------------------------------------
# 3. GOOGLE ТАБЛИЦА (необязательно, но нужно по сценарию №5)
# ---------------------------------------------------------------------------

# false — заявки всё равно сохраняются, но в локальную БД и в
# data/applications_export.csv, уведомление организаторам уйдёт в любом случае.
SHEETS_ENABLED=true

# Опрос таблицы: бот сам забирает статус, если организатор поменял его
# прямо в ячейке «Статус», и уведомляет участника. Основной способ работы
# куратора — можно не писать «!статус» в чат.
SHEETS_POLL_ENABLED=true

# Как часто читать таблицу, секунд (минимум 30). Чаще не нужно: Google
# умеет 60 запросов в минуту на пользователя.
SHEETS_POLL_INTERVAL_SEC=120

# ID таблицы из адреса:
# https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOp/edit  →  1AbCdEfGhIjKlMnOp
GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOp0000000000000000000

# Файл JSON-ключа сервис-аккаунта Google.
# https://console.cloud.google.com → «Создать проект» → «Включить Google Sheets API» →
# «Создать учётные данные» → «Сервисный аккаунт» → создать ключ JSON →
# сохранить файл и положить его ВНЕ папки проекта.
# Таблицу нужно открыть на доступ этому сервис-аккаунту («Доступ» → «Все, у кого есть ссылка»
# → «Редактор»).
GOOGLE_CREDENTIALS_FILE=data/gcp-service-account.json

# Альтернатива файлу — сам JSON одной строкой. Используйте что-то одно.
# Внимание: длинный JSON в .env неудобно читать, поэтому вариант с файлом предпочтительнее.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}


# ---------------------------------------------------------------------------
# 4. ПРОМПТ И БАЗА ЗНАНИЙ
# ---------------------------------------------------------------------------

PROMPT_FILE=SYSTEM_PROMPT_Irina_Zvonky_Bereg.md

# Характер и тон Ирины. Отдельный файл, чтобы характер можно было править,
# не трогая системный промпт. Если файла нет — бот работает, просто характер
# из промпта не подгружается.
CHARACTER_FILE=Irina_Character.md

KNOWLEDGE_BASE_FILE=Zvonky_Bereg_Knowledge_Base.md

# summary — в модель уходит только системный промпт (в нём уже есть сжатая база) — дёшево.
# full    — дополнительно целиком добавляется база знаний — дороже, но точнее на редких вопросах.
KB_MODE=summary


# ---------------------------------------------------------------------------
# 5. ХРАНИЛИЩЕ И ЛОГИ
# ---------------------------------------------------------------------------

DB_PATH=data/bot.sqlite3
LOG_FILE=data/bot.log
LOG_LEVEL=INFO

# true  — телефон и почта остаются в локальной базе (нужно для офлайн-уведомлений
#         и истории заявок). База — файл с персональными данными, держите её на
#         своём диске и не выкладывайте в облако без шифрования.
# false — локально остаются только хеши телефона; реальные телефон и почта
#         уходят в Google Таблицу и в уведомление организатору, но в SQLite
#         их нет. Хеш необратим, поэтому поиск дублей работает в обоих режимах.
STORE_PII_LOCALLY=false

# Куда складывать CSV-выгрузку, если Google Таблица выключена или недоступна.
# Указывается вручную: путь должен совпадать с файлом, который вы будете читать.
CSV_EXPORT=data/applications_export.csv


# ---------------------------------------------------------------------------
# 6. ПОВЕДЕНИЕ
# ---------------------------------------------------------------------------

# Через сколько минут тишины бот напоминает о брошенной анкете.
IDLE_TIMEOUT_MIN=15

# Сколько последних реплик уходит в модель как контекст.
CONTEXT_MESSAGES=8

# Ограничения ввода.
MAX_TEXT_LEN=2000
MAX_DESCRIPTION_LEN=1500

# Антифлуд: сколько сообщений в минуту от одного человека и суммарно.
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_GLOBAL_PER_MIN=120

# Минимальный интервал между вызовами модели, секунды (экономия токенов).
LLM_MIN_INTERVAL_SEC=1.0

# Предупреждение «лучше в личку» перед телефоном и почтой в групповом чате.
ASK_PRIVATE_CHAT_HINT=false

# Системный индикатор «печатает…» от VK (messages.setActivity) на время
# ответа модели. Это статус набора текста, а не сообщение в чате: в переписке
# ничего не появляется. Если сообществу метод недоступен, индикатор молча
# выключается.
# TYPING_DELAY_SEC — сколько ждать перед индикатором: на быстрые ответы
# (нажатие кнопки) он не показывается вовсе.
TYPING_ENABLED=true
TYPING_DELAY_SEC=0.0

# Экстренные контакты (телефон дежурного, координатора и т.п.) — подставляются
# в сообщение при ЧП. Не обязательно.
# EMERGENCY_CONTACTS=+7 900 000-00-00,+7 900 000-00-01

PUBLIC_SITE=zv-bereg.ru
PUBLIC_EMAIL=info@zv-bereg.ru


# ---------------------------------------------------------------------------
# 7. РАСШИРЕННЫЕ КАТЕГОРИИ (обычно менять не нужно)
# ---------------------------------------------------------------------------
# Пример изменения листов в Google Таблице:
# CATEGORIES_JSON=[{"key":"musician","title":"Музыкант / группа","sheet":"Музыканты_Группы","prompt_hint":"жанр, состав, своя техника"}, {"key":"artist","title":"Художник / мастер","sheet":"Художники_Мастера","prompt_hint":"что делаешь, нужен ли стенд"}, {"key":"food","title":"Фуд-корт","sheet":"Фудкорт","prompt_hint":"что готовите, веган-опции"}, {"key":"volunteer","title":"Волонтёр","sheet":"Волонтёры","prompt_hint":"дни, зона интереса, опыт"}]
